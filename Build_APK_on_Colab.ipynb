      "source": [
        "# Build Android APK with Buildozer on Google Colab\n",
        "\n",
        "This notebook compiles your Kivy app into an Android APK.\n",
        "\n",
        "**Instructions:**\n",
        "1. Runtime → Restart runtime... (if re-running)\n",
        "2. Runtime → Run all\n",
        "3. Wait 30-60 minutes\n",
        "4. Download the APK from the final step\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Step 1: System dependencies + Python packages + Rust\n",
        "import subprocess, sys, os\n",
        "\n",
        "print(\"=== Installing system dependencies ===\")\n",
        "subprocess.run([\"apt\", \"update\", \"-qq\"], check=True)\n",
        "subprocess.run([\n",
        "    \"apt\", \"install\", \"-y\", \"-qq\",\n",
        "    \"python3-pip\", \"python3-dev\", \"git\", \"zip\", \"unzip\",\n",
        "    \"openjdk-17-jdk\", \"libffi-dev\", \"libssl-dev\",\n",
        "    \"wget\", \"curl\", \"build-essential\", \"autoconf\", \"libtool\",\n",
        "    \"pkg-config\", \"zlib1g-dev\", \"libbz2-dev\"\n",
        "], check=True)\n",
        "\n",
        "# Set JAVA_HOME\n",
        "os.environ[\"JAVA_HOME\"] = \"/usr/lib/jvm/java-17-openjdk-amd64\"\n",
        "os.environ[\"PATH\"] = os.environ[\"JAVA_HOME\"] + \"/bin:\" + os.environ[\"PATH\"]\n",
        "print(f\"JAVA_HOME={os.environ['JAVA_HOME']}\")\n",
        "\n",
        "print(\"\\n=== Installing Cython 0.29.19 ===\")\n",
        "subprocess.run([sys.executable, \"-m\", \"pip\", \"install\", \"cython==0.29.19\"], check=True)\n",
        "\n",
        "print(\"\\n=== Installing buildozer 1.5.0 ===\")\n",
        "subprocess.run([sys.executable, \"-m\", \"pip\", \"install\", \"buildozer==1.5.0\"], check=True)\n",
        "\n",
        "print(\"\\n=== Installing Rust (required by cryptography) ===\")\n",
        "cargo_bin = os.path.expanduser(\"~/.cargo/bin\")\n",
        "rustup = os.path.join(cargo_bin, \"rustup\")\n",
        "if not os.path.exists(rustup):\n",
        "    print(\"Rust not found, installing...\")\n",
        "    # Download rustup-init directly (more reliable than curl | sh)\n",
        "    rustup_init = \"/tmp/rustup-init\"\n",
        "    subprocess.run([\"wget\", \"-q\", \"https://static.rust-lang.org/rustup/dist/x86_64-unknown-linux-gnu/rustup-init\", \"-O\", rustup_init], check=True)\n",
        "    os.chmod(rustup_init, 0o755)\n",
        "    result = subprocess.run([rustup_init, \"-y\", \"--default-toolchain\", \"stable\"], timeout=300)\n",
        "    print(f\"Rust install exit code: {result.returncode}\")\n",
        "    os.unlink(rustup_init)\n",
        "else:\n",
        "    print(\"Rust already installed.\")\n",
        "\n",
        "# Add cargo/bin to PATH (critical!)\n",
        "if cargo_bin not in os.environ[\"PATH\"]:\n",
        "    os.environ[\"PATH\"] = cargo_bin + os.pathsep + os.environ[\"PATH\"]\n",
        "os.environ[\"CARGO_HOME\"] = os.path.expanduser(\"~/.cargo\")\n",
        "print(f\"PATH includes cargo: {'cargo' in os.environ['PATH'] or 'cargo' in os.environ['PATH']}\")\n",
        "\n",
        "# Verify rustup is findable\n",
        "for cmd in [\"rustup\", \"rustc\", \"cargo\"]:\n",
        "    path = os.path.join(cargo_bin, cmd)\n",
        "    if os.path.exists(path):\n",
        "        ver = subprocess.run([path, \"--version\"], capture_output=True, text=True).stdout.strip()\n",
        "        print(f\"  {cmd}: {ver}\")\n",
        "    else:\n",
        "        print(f\"  {cmd}: NOT FOUND at {path}\")\n",
        "\n",
        "print(\"\\n✅ Step 1 complete!\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Step 2: Patch buildozer (skip root check) + install Android SDK\n",
        "import os, subprocess, sys, shutil\n",
        "\n",
        "# === Patch buildozer check_root ===\n",
        "print(\"=== Patching buildozer (skip root check) ===\")\n",
        "result = subprocess.run(\n",
        "    [sys.executable, \"-m\", \"pip\", \"show\", \"buildozer\"],\n",
        "    capture_output=True, text=True, check=True\n",
        ")\n",
        "location = None\n",
        "for line in result.stdout.splitlines():\n",
        "    if line.startswith(\"Location:\"):\n",
        "        location = line.split(\":\", 1)[1].strip()\n",
        "        break\n",
        "init_path = os.path.join(location, \"buildozer\", \"__init__.py\")\n",
        "print(f\"Patching: {init_path}\")\n",
        "with open(init_path, 'r') as f:\n",
        "    lines = f.readlines()\n",
        "new_lines = []\n",
        "skip = False\n",
        "for line in lines:\n",
        "    if 'def check_root(self):' in line:\n",
        "        skip = True\n",
        "        new_lines.append(line)\n",
        "        new_lines.append('        \\\"\\\"\\\"Patched: skip root check\\\"\\\"\\\"\\n')\n",
        "        new_lines.append('        return\\n')\n",
        "        continue\n",
        "    if skip:\n",
        "        if line.startswith('    def ') or line.startswith('class '):\n",
        "            skip = False\n",
        "        else:\n",
        "            continue\n",
        "    new_lines.append(line)\n",
        "with open(init_path, 'w') as f:\n",
        "    f.writelines(new_lines)\n",
        "print(\"✅ Patched buildozer: check_root() disabled\")\n",
        "\n",
        "# === Install Android SDK command-line tools ===\n",
        "print(\"\\n=== Installing Android SDK ===\")\n",
        "sdk_root = os.path.expanduser(\"~/.buildozer/android/platform/android-sdk\")\n",
        "cmdline_dir = os.path.join(sdk_root, \"cmdline-tools\")\n",
        "os.makedirs(cmdline_dir, exist_ok=True)\n",
        "latest_dir = os.path.join(cmdline_dir, \"latest\")\n",
        "if not os.path.exists(latest_dir):\n",
        "    print(\"Downloading Android command-line tools...\")\n",
        "    subprocess.run([\"wget\", \"-q\", \"https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip\", \"-O\", \"/tmp/cmdline-tools.zip\"], check=True)\n",
        "    subprocess.run([\"unzip\", \"-q\", \"-o\", \"/tmp/cmdline-tools.zip\", \"-d\", cmdline_dir], check=True)\n",
        "    os.rename(os.path.join(cmdline_dir, \"cmdline-tools\"), latest_dir)\n",
        "    print(\"✅ Command-line tools installed.\")\n",
        "else:\n",
        "    print(\"✅ Command-line tools already present.\")\n",
        "\n",
        "# Copy sdkmanager to OLD path (buildozer expects tools/bin/sdkmanager)\n",
        "tools_bin = os.path.join(sdk_root, \"tools\", \"bin\")\n",
        "os.makedirs(tools_bin, exist_ok=True)\n",
        "src = os.path.join(latest_dir, \"bin\", \"sdkmanager\")\n",
        "dst = os.path.join(tools_bin, \"sdkmanager\")\n",
        "if not os.path.exists(dst):\n",
        "    shutil.copy2(src, dst)\n",
        "    os.chmod(dst, 0o755)\n",
        "    print(f\"✅ Copied sdkmanager to {dst}\")\n",
        "# Copy lib too\n",
        "src_lib = os.path.join(latest_dir, \"lib\")\n",
        "dst_lib = os.path.join(sdk_root, \"tools\", \"lib\")\n",
        "if os.path.exists(dst_lib): shutil.rmtree(dst_lib)\n",
        "shutil.copytree(src_lib, dst_lib)\n",
        "print(f\"✅ Copied tools/lib\")\n",
        "\n",
        "# Accept licenses + install build-tools + platform\n",
        "print(\"\\n=== Accepting SDK licenses ===\")\n",
        "proc = subprocess.Popen([dst, \"--licenses\"], stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)\n",
        "stdout, stderr = proc.communicate(input='y\\ny\\ny\\ny\\ny\\ny\\ny\\ny\\n')\n",
        "print(\"Licenses accepted.\")\n",
        "print(\"\\n=== Installing build-tools + platform ===\")\n",
        "subprocess.run([dst, \"build-tools;30.0.3\"], check=True)\n",
        "subprocess.run([dst, \"platforms;android-30\"], check=True)\n",
        "print(\"\\n✅ Step 2 complete!\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Step 3: Clone repo, update buildozer.spec, verify Rust on PATH\n",
        "import os, subprocess, shutil, re, sys\n",
        "\n",
        "if os.path.exists(\"network-scanner\"):\n",
        "    print(\"Removing old directory...\")\n",
        "    shutil.rmtree(\"network-scanner\")\n",
        "\n",
        "print(\"Cloning repository...\")\n",
        "subprocess.run([\"git\", \"clone\", \"https://github.com/Loongood666/network-scanner.git\"], check=True)\n",
        "os.chdir(\"network-scanner/android\")\n",
        "print(f\"Working dir: {os.getcwd()}\")\n",
        "\n",
        "# Update buildozer.spec\n",
        "with open(\"buildozer.spec\", 'r') as f:\n",
        "    spec = f.read()\n",
        "spec = re.sub(r'android\\.ndk\\s*=\\s*\\S+', 'android.ndk = 28c', spec)\n",
        "if 'android.build_tools' not in spec:\n",
        "    spec += '\\nandroid.build_tools = 30.0.3\\n'\n",
        "else:\n",
        "    spec = re.sub(r'android\\.build_tools\\s*=\\s*\\S+', 'android.build_tools = 30.0.3', spec)\n",
        "with open(\"buildozer.spec\", 'w') as f:\n",
        "    f.write(spec)\n",
        "print(\"✅ buildozer.spec updated.\")\n",
        "\n",
        "# CRITICAL: Ensure cargo/bin is on PATH for the build process\n",
        "cargo_bin = os.path.expanduser(\"~/.cargo/bin\")\n",
        "if cargo_bin not in os.environ.get(\"PATH\", \"\"):\n",
        "    os.environ[\"PATH\"] = cargo_bin + os.pathsep + os.environ[\"PATH\"]\n",
        "print(f\"\\nPATH includes ~/.cargo/bin: {cargo_bin in os.environ['PATH']}\")\n",
        "\n",
        "# Verify rustup is accessible\n",
        "print(\"\\n=== Verifying Rust is accessible ===\")\n",
        "for cmd in [\"rustup\", \"rustc\", \"cargo\"]:\n",
        "    r = subprocess.run([\"which\", cmd], capture_output=True, text=True)\n",
        "    if r.returncode == 0:\n",
        "        print(f\"  {cmd}: {r.stdout.strip()}\")\n",
        "    else:\n",
        "        print(f\"  {cmd}: NOT FOUND (will add to PATH)\")\n",
        "        # Add to PATH and try again\n",
        "        os.environ[\"PATH\"] = cargo_bin + os.pathsep + os.environ[\"PATH\"]\n",
        "\n",
        "print(\"\\n✅ Step 3 complete!\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": { \"colab\": { \"background_save\": true } },
      "outputs": [],
      "source": [
        "# Step 4: Build APK (30-60 minutes)\n",
        "# Ensures Rust is on PATH, then runs buildozer with live output\n",
        "import os, subprocess, sys\n",
        "\n",
        "os.chdir(\"/content/network-scanner/android\")\n",
        "\n",
        "# Set all Android env vars\n",
        "sdk_root = os.path.expanduser(\"~/.buildozer/android/platform/android-sdk\")\n",
        "os.environ[\"ANDROID_SDK_ROOT\"] = sdk_root\n",
        "os.environ[\"ANDROID_HOME\"] = sdk_root\n",
        "os.environ[\"JAVA_HOME\"] = \"/usr/lib/jvm/java-17-openjdk-amd64\"\n",
        "\n",
        "# CRITICAL: Add cargo/bin to PATH (rustup MUST be findable)\n",
        "cargo_bin = os.path.expanduser(\"~/.cargo/bin\")\n",
        "if cargo_bin not in os.environ[\"PATH\"]:\n",
        "    os.environ[\"PATH\"] = cargo_bin + os.pathsep + os.environ[\"PATH\"]\n",
        "os.environ[\"CARGO_HOME\"] = os.path.expanduser(\"~/.cargo\")\n",
        "\n",
        "# Final verification before build\n",
        "print(\"=== Pre-build verification ===\")\n",
        "print(f\"JAVA_HOME={os.environ['JAVA_HOME']}\")\n",
        "print(f\"ANDROID_HOME={os.environ['ANDROID_HOME']}\")\n",
        "print(f\"PATH includes cargo/bin: {cargo_bin in os.environ['PATH']}\")\n",
        "r = subprocess.run([\"rustup\", \"--version\"], capture_output=True, text=True)\n",
        "print(f\"rustup: {r.stdout.strip() or r.stderr.strip()}\")\n",
        "\n",
        "print(\"\\n=== Starting APK build (30-60 min) ===\")\n",
        "print(\"Output will appear below in real time:\\n\")\n",
        "\n",
        "# Run with Popen to stream output live\n",
        "process = subprocess.Popen(\n",
        "    [sys.executable, \"-m\", \"buildozer\", \"-v\", \"android\", \"debug\"],\n",
        "    stdout=subprocess.PIPE,\n",
        "    stderr=subprocess.STDOUT,\n",
        "    text=True,\n",
        "    bufsize=1\n",
        ")\n",
        "for line in process.stdout:\n",
        "    print(line, end='', flush=True)\n",
        "process.wait()\n",
        "\n",
        "print(f\"\\n\\nBuild exited with code: {process.returncode}\")\n",
        "if process.returncode == 0:\n",
        "    print(\"\\n✅ Build completed successfully!\")\n",
        "else:\n",
        "    print(f\"\\n❌ Build failed with return code {process.returncode}\")\n",
        "    sys.exit(1)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Step 5: Download the APK\n",
        "import os\n",
        "from google.colab import files\n",
        "\n",
        "apk_dir = \"/content/network-scanner/android/bin\"\n",
        "if os.path.exists(apk_dir):\n",
        "    apks = [f for f in os.listdir(apk_dir) if f.endswith(\".apk\")]\n",
        "    if apks:\n",
        "        print(f\"✅ Found APK: {apks[0]}\")\n",
        "        files.download(os.path.join(apk_dir, apks[0]))\n",
        "    else:\n",
        "        print(\"❌ No APK found in bin/.\")\n",
        "        print(\"Files in bin/:\", os.listdir(apk_dir))\n",
        "else:\n",
        "    print(\"❌ bin/ directory not found.\")"
      ]
    }
